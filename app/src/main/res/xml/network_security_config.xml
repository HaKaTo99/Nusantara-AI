<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config — Nusantara AI Production
    Memastikan semua trafik melalui HTTPS/TLS.
    Localhost diizinkan untuk debugging dan local model server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Izinkan cleartext untuk localhost saja (local model server / debugging) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
