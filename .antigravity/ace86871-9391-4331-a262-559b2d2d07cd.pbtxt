        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val genres = listOf(\"Synthwave Cyberpunk\", \"Lo-Fi Chill Hop\", \"Epic Orchestral\", \"Indonesian Gamelan Fusion\", \"Ambient Meditation\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
