  file_change {
    absolute_path_uri: "file:///app/src/main/java/com/example/domain/voice/VoiceInteractionManager.kt"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "package com.example.domain.voice\n\nimport android.content.Context\nimport android.content.Intent\nimport android.os.Bundle\nimport android.speech.RecognitionListener\nimport android.speech.RecognizerIntent\nimport android.speech.SpeechRecognizer\nimport android.speech.tts.TextToSpeech\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport java.util.Locale\n\nclass VoiceInteractionManager(\n    private val context: Context\n) : TextToSpeech.OnInitListener {\n\n    private var textToSpeech: TextToSpeech? = null\n    private var speechRecognizer: SpeechRecognizer? = null\n    private var isTtsReady = false\n\n    private val _isSpeaking = MutableStateFlow(false)\n    val isSpeaking: StateFlow<Boolean> = _isSpeaking.asStateFlow()\n\n    private val _isListening = MutableStateFlow(false)\n    val isListening: StateFlow<Boolean> = _isListening.asStateFlow()\n\n    private val _voiceAmplitude = MutableStateFlow(0f)\n    val voiceAmplitude: StateFlow<Float> = _voiceAmplitude.asStateFlow()\n\n    private val _recognizedText = MutableStateFlow(\"\")\n    val recognizedText: StateFlow<String> = _recognizedText.asStateFlow()\n\n    init {\n        try {\n            textToSpeech = TextToSpeech(context, this)\n            if (SpeechRecognizer.isRecognitionAvailable(context)) {\n                speechRecognizer = SpeechRecognizer.createSpeechRecognizer(context)\n            }\n        } catch (e: Exception) {\n            // Speech fallback\n        }\n    }\n\n    override fun onInit(status: Int) {\n        if (status == TextToSpeech.SUCCESS) {\n            val result = textToSpeech?.setLanguage(Locale(\"id\", \"ID\"))\n            if (result == TextToSpeech.LANG_MISSING_DATA || result == TextToSpeech.LANG_NOT_SUPPORTED) {\n                textToSpeech?.setLanguage(Locale.US)\n            }\n            isTtsReady = true\n        }\n    }\n\n    fun speak(text: String) {\n        if (isTtsReady) {\n            _isSpeaking.value = true\n            textToSpeech?.speak(\n                text.replace(\"*\", \"\").replace(\"#\", \"\"),\n                TextToSpeech.QUEUE_FLUSH,\n                null,\n                \"TTS_ID\"\n            )\n        }\n    }\n\n    fun stopSpeaking() {\n        textToSpeech?.stop()\n        _isSpeaking.value = false\n    }\n\n    fun startListening(onResult: (String) -> Unit) {\n        if (speechRecognizer == null) {\n            speechRecognizer = SpeechRecognizer.createSpeechRecognizer(context)\n        }\n\n        val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {\n            putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)\n            putExtra(RecognizerIntent.EXTRA_LANGUAGE, \"id-ID\")\n            putExtra(RecognizerIntent.EXTRA_PROMPT, \"Bicara sekarang...\")\n        }\n\n        speechRecognizer?.setRecognitionListener(object : RecognitionListener {\n            override fun onReadyForSpeech(params: Bundle?) {\n                _isListening.value = true\n            }\n\n            override fun onBeginningOfSpeech() {\n                _voiceAmplitude.value = 0.5f\n            }\n\n            override fun onRmsChanged(rmsdB: Float) {\n                _voiceAmplitude.value = (rmsdB / 10f).coerceIn(0.1f, 1.0f)\n            }\n\n            override fun onBufferReceived(buffer: ByteArray?) {}\n            override fun onEndOfSpeech() {\n                _isListening.value = false\n                _voiceAmplitude.value = 0f\n            }\n\n            override fun onError(error: Int) {\n                _isListening.value = false\n                _voiceAmplitude.value = 0f\n            }\n\n            override fun onResults(results: Bundle?) {\n                _isListening.value = false\n                _voiceAmplitude.value = 0f\n                val matches = results?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)\n                val text = matches?.firstOrNull() ?: \"\"\n                _recognizedText.value = text\n                if (text.isNotBlank()) {\n                    onResult(text)\n                }\n            }\n\n            override fun onPartialResults(partialResults: Bundle?) {}\n            override fun onEvent(eventType: Int, params: Bundle?) {}\n        })\n\n        try {\n            speechRecognizer?.startListening(intent)\n        } catch (e: Exception) {\n            _isListening.value = false\n        }\n    }\n\n    fun stopListening() {\n        speechRecognizer?.stopListening()\n        _isListening.value = false\n        _voiceAmplitude.value = 0f\n    }\n\n    fun release() {\n        textToSpeech?.stop()\n        textToSpeech?.shutdown()\n        speechRecognizer?.destroy()\n    }\n}\n"
    }
