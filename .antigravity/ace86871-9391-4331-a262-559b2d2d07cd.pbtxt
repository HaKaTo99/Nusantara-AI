        }
        lines {
          text: "fun AudioAndMusicStudioTab() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val context = LocalContext.current"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var audioPrompt by remember { mutableStateOf(\"\") }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
