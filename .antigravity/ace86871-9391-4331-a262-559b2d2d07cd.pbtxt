          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val cameraMotions = listOf(\"Pan Right\", \"Dynamic Orbit\", \"Zoom In (Dolly)\", \"FPV Drone Dive\", \"Tilt Up\")"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
