          text: "    var selectedGenre by remember { mutableStateOf(\"Synthwave Cyberpunk\") }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var selectedBpm by remember { mutableIntStateOf(120) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var isPlayingTrack by remember { mutableStateOf(false) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    var activeTrackTitle by remember { mutableStateOf<String?>(null) }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
